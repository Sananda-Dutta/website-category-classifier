{
  "manifest_version": 3,
  "name": "Website Category Classifier",
  "version": "1.0.0",
  "description": "Classify any website into 11 categories using DistilBERT. Shows category, confidence, Top 3, and brand safety verdict.",
  "author": "SanandaDutta",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Website Category Classifier",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://website-category-classifier.onrender.com/*"
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}